PORT=4001
HOST=localhost
NODE_ENV=development
APP_NAME=gym-stack
LOG_LEVEL=info

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# JWT — admin and gym MUST use different secrets
ADMIN_JWT_SECRET=change_me_admin_jwt_64_hex
JWT_SECRET=change_me_gym_jwt_64_hex
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=15d

# API Security (matched by frontend Vite proxy)
API_KEY=sk_live_change_me
CLIENT_ID=gymstack_client_id
CLIENT_SECRET=pk_live_change_me

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Email 2FA + gym invite (Brevo)
BREVO_API_KEY=
BREVO_EMAIL=hello@example.com

# Dev: include OTP in API response when Brevo is missing
OTP_EXPOSE_IN_RESPONSE=true
OTP_EXPIRES_MINUTES=10

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymstack?schema=public

# Frontend login URL used in invite emails
APP_URL=http://localhost:5173
