# Relative URL → Vite proxy adds API headers (recommended for local)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Gym Stack Management
VITE_BASE_PATH=/

# Browser backup headers (prefer proxy; do not commit real secrets)
VITE_API_KEY=sk_live_change_me
VITE_CLIENT_ID=gymstack_client_id
VITE_CLIENT_SECRET=pk_live_change_me

# Server-only — used by vite.config.js proxy
API_PROXY_TARGET=http://localhost:4001
API_KEY=sk_live_change_me
CLIENT_ID=gymstack_client_id
CLIENT_SECRET=pk_live_change_me
